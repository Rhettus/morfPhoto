# Copy to .env and adapt.

# Photo directory on the host, mounted read-only at /photos (required).
PHOTOS_DIR=/srv/photos

# Account the service runs as. It must be able to read PHOTOS_DIR.
PUID=1000
PGID=1000

# Port published on the host.
MORFPHOTO_PORT=8793

# Bearer key for the API. Generate one with: openssl rand -hex 32
MORFPHOTO_API_KEY=

# Number of concurrent ExifTool readers (1 to 4).
MORFPHOTO_EXIF_WORKERS=2

# Optional NAS directory for previews. Requires docker-compose.thumbnails.yml.
# MORFPHOTO_THUMBNAIL_DIR=/storage/morfphoto/thumbnail-cache
# Number of background thumbnail workers (1 to 4).
# MORFPHOTO_THUMBNAIL_WORKERS=4

# Log HTTP route categories, response status, and timing.
MORFPHOTO_HTTP_DEBUG=0

# Image to run.
# MORFPHOTO_IMAGE=ghcr.io/rhettus/morfphoto:latest
